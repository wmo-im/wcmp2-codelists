@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .

<publisher> a skos:Concept ;
        rdfs:label "publisher" ;
        skos:notation "publisher" ;
        dct:description "The name of the entity that holds, archives, publishes prints, distributes, releases, issues, or produces the resource"@en ;
        rdfs:isDefinedBy "https://datacite-metadata-schema.readthedocs.io/en/4.6/properties/publisher" .